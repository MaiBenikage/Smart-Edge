<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material3 parent (was Theme.AppCompat.Light): MaterialAlertDialogBuilder
         needs colorSurface, which AppCompat does not define — the dialog in
         ProcessTextActivity crashed on every use. DayNight also makes the
         chooser follow dark mode instead of always being light. -->
    <style name="Theme.Transparent" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <style name="Widget.App.Slider" parent="Widget.Material3.Slider">
        <item name="trackHeight">22dp</item>
        <item name="thumbRadius">11dp</item>
        <item name="thumbColor">?attr/colorPrimary</item>
        <item name="trackColorInactive">?attr/colorSurfaceContainerHighest</item>
        <item name="trackColorActive">?attr/colorPrimary</item>
        <item name="thumbElevation">0dp</item>
        <item name="haloColor">@android:color/transparent</item>
        <item name="haloRadius">0dp</item>
    </style>
</resources>
