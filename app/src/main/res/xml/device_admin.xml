<?xml version="1.0" encoding="utf-8"?>
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <!-- force-lock backs DevicePolicyManager.lockNow(): allow the Lock
             Screen tool to lock the device immediately. (It does not back
             setKeyguardDisabled(), which takes no uses-policy.) -->
        <force-lock />
    </uses-policies>
</device-admin>
