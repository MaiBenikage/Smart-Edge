<?xml version="1.0" encoding="utf-8"?>
<!-- Editor dialog for one TextAction. Sections are shown/hidden per action type. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/text_actions_field_name"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etActionName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="@string/text_actions_field_name_hint"
            android:inputType="text"
            android:maxLines="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/text_actions_field_type"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp" />

        <Spinner
            android:id="@+id/spinnerActionType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <!-- OPEN_URL -->
        <LinearLayout
            android:id="@+id/layoutUrlTemplate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/text_actions_field_url_template"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etUrlTemplate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="https://www.google.com/search?q={encoded}"
                android:inputType="textUri"
                android:maxLines="3" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/text_actions_template_help"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- REPLACE_TEXT -->
        <LinearLayout
            android:id="@+id/layoutReplaceTransform"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/text_actions_field_transform"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp" />

            <Spinner
                android:id="@+id/spinnerReplaceTransform"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/text_actions_replace_help"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- LAUNCH_APP -->
        <LinearLayout
            android:id="@+id/layoutTargetPackage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/text_actions_field_target_package"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etTargetPackage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="com.example.app"
                android:inputType="text"
                android:maxLines="1" />
        </LinearLayout>

        <!-- CUSTOM_INTENT -->
        <LinearLayout
            android:id="@+id/layoutCustomIntent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/text_actions_field_intent_action"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etIntentAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="android.intent.action.VIEW"
                android:inputType="text"
                android:maxLines="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/text_actions_field_intent_data"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etIntentData"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="https://example.com/?q={encoded}"
                android:inputType="textUri"
                android:maxLines="2" />
        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchEditableOnly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/text_actions_field_editable_only" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchActionEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/text_actions_field_enabled" />

    </LinearLayout>
</ScrollView>
